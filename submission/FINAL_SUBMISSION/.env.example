# TrustLens Environment Configuration
# Copy this file to .env to customize settings

# Host Environment (Localhost-only by default; access via SSH port-forwarding)
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_HEADLESS=true

# Security Settings
ALLOW_EXTERNAL_AI=false
DEFAULT_MODEL=local_grounded
MAX_FILE_SIZE_MB=10

# Optional External AI Endpoints (Requires explicit user opt-in)
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
